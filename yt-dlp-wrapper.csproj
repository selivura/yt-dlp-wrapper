<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>yt_dlp_wrapper</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.10.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tg-bot.Tests/**/*.cs" />
    <EmbeddedResource Remove="tg-bot.Tests/**/*" />
    <None Remove="tg-bot.Tests/**/*" />
    <Content Remove="tg-bot.Tests/**/*" />
  </ItemGroup>

</Project>
